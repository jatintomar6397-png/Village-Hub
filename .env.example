# Server & Runtime Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated, or '*' for open access during initial deployment)
# Example: https://village-hub.vercel.app,http://localhost:5000
ALLOWED_ORIGINS=*

# Frontend API Target (used in client config.js when deployed)
# Example: https://village-hub-backend.onrender.com
API_BASE_URL=

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# JWT & Authentication Secret
JWT_SECRET=your_strong_random_jwt_secret_here

# Administrator Account Initial Credentials
ADMIN_EMAIL=admin@villagehub.in
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Legacy Development Database (Optional fallback when MongoDB is running locally)
MONGODB_URI=mongodb://localhost:27017/villagehub
